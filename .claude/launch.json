{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "membrane-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "18473",
        "--bind",
        "127.0.0.1",
        "--directory",
        "src/neusci_daq"
      ],
      "url": "http://localhost:18473",
      "port": 18473
    },
    {
      "name": "lessons-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "18491",
        "--bind",
        "127.0.0.1",
        "--directory",
        "src/neusci_daq/lessons"
      ],
      "url": "http://localhost:18491",
      "port": 18491
    },
    {
      "name": "newt-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PY=.venv/bin/python; [ -x $PY ] || PY=../../../.venv/bin/python; PYTHONPATH=src exec $PY -m neusci_daq.web --serve --port 18520 --key dev"
      ],
      "url": "http://127.0.0.1:18520",
      "port": 18520
    }
  ]
}
